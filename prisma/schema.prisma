// TwinHire — Evidence-Based Recruitment Operating System
// Prisma schema (PostgreSQL / Neon). Graphs/metrics stored as JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth models ──────────────────────────────────────────────────────

/// Platform users — admin, candidate, business. Created by admin from waitlist.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  /// bcrypt-hashed password
  passwordHash String
  /// admin | candidate | business
  role         String   @default("candidate")
  /// Linked candidate record (for candidate users)
  candidateId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Sign-ups land here until an admin creates their account.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  /// pending | approved | rejected
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Twin models ──────────────────────────────────────────────────────

/// A continuously evolving AI Digital Twin of a real business (anonymized).
model BusinessTwin {
  id            String   @id @default(cuid())
  code          String   @unique
  industry      String
  sizeBand      String
  stage         String
  region        String
  tagline       String
  problems      String
  objectives    String
  kpis          String
  capabilities  String
  capabilityBacklog String
  capabilitiesIdentified Int @default(0)
  orgSnapshot   String
  fidelity      Int      @default(72)
  sessionsObserved Int   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      WorkSession[]
}

/// A candidate represented as a continuously evolving capability graph (not a resume).
model Candidate {
  id              String   @id @default(cuid())
  handle          String   @unique
  displayName     String
  headline        String
  capabilityGraph String
  profile         String
  reputation      Int      @default(50)
  sessionsCompleted Int    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        WorkSession[]
}

/// A candidate performing real work inside a business twin. The core unit of evidence.
model WorkSession {
  id            String   @id @default(cuid())
  twinId        String
  candidateId   String
  capabilityKey String
  taskTitle     String
  taskBrief     String
  contextBundle String
  status        String   @default("assigned")
  submission    String?
  submittedAt   DateTime?
  evaluation    String?
  recommendation String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  twin           BusinessTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}
